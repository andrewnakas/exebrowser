# Cloudflare Pages headers.
#
# IMPORTANT: Cloudflare Pages MERGES headers from every matching rule.
# Emitting Cross-Origin-Embedder-Policy more than once causes Chrome to
# treat the policy as "unsafe-none" and disables SharedArrayBuffer.
#
# COOP/COEP/CORP (2026-07): removed from the catch-all. The 32-bit Boxedwine
# and DOSBox runtimes are single-threaded — no SharedArrayBuffer anywhere in
# their JS glue — so cross-origin isolation buys nothing there, while
# COEP: require-corp blocks AdSense/third-party iframes on every page.
# Only the experimental /64/ pthreads runtime needs isolation; it keeps
# COOP/COEP via its own rule below (plus its coi-serviceworker fallback).

/app.js
  Cache-Control: public, max-age=60, must-revalidate

/embed.js
  Cache-Control: public, max-age=60, must-revalidate

/dos-embed.js
  Cache-Control: public, max-age=60, must-revalidate

/save-core.js
  Cache-Control: public, max-age=60, must-revalidate

# Snapshot spike runtime (generated by scripts/make-snap-runtime.mjs). Short
# TTL, NOT immutable: this is the file the experiment iterates on, and it must
# never share a cache entry with the real /dosbox/ runtime.
/dosbox-snap/*
  Cache-Control: public, max-age=300, must-revalidate

/dos-snapshot.js
  Cache-Control: public, max-age=60, must-revalidate

/style.css
  Cache-Control: public, max-age=60, must-revalidate

/index.html
  Cache-Control: public, max-age=60, must-revalidate

/
  Cache-Control: public, max-age=60, must-revalidate

# Content-Type only. Cache policy is set per-directory below, because _headers
# MERGES rules: a blanket immutable here collided with the space-cadet
# no-cache rule and emitted "immutable, no-cache" on the same response.
/*.wasm
  Content-Type: application/wasm

/boxedwine/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/dosbox/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/boxedwine/build/default/*
  Cache-Control: public, max-age=31536000, immutable

/boxedwine/build/18r2/*
  Cache-Control: public, max-age=31536000, immutable

# 64-bit (Boxedwine64 / wine64) experimental runtime + split rootfs parts.
# Immutable: the wasm/js and the rootfs .partNNN pieces never change in place
# (a new build ships new filenames). Same-origin, so COEP require-corp from the
# /64/* isolation rule below is satisfied without a CORP header.
/64/*.part*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/64/*.zip
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/zip

/64/boxedwine64.wasm
  Cache-Control: public, max-age=31536000, immutable

/64/boxedwine64.js
  Cache-Control: public, max-age=31536000, immutable

# Proxied via Pages Function (functions/api/fs/[file].js) → Worker.
/api/fs/*
  Cache-Control: public, max-age=3600
  Content-Type: application/zip

/boxedwine/apps/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/zip

# DOSBox runtime JS (js-dos emulators.js + wdosbox.js). Vendored at a pinned
# version and only replaced wholesale, so a repeat visitor should never
# re-download them — the biggest win for return-visit boot time.
# Scoped to *.js on purpose: wdosbox.wasm is already covered by the /*.wasm
# rule above, and _headers MERGES matching rules rather than overriding, so a
# second immutable rule would emit the directive twice.
/dosbox/*.js
  Cache-Control: public, max-age=31536000, immutable

# Hosted game payloads. Not immutable — we do rebuild these in place when a
# payload turns out to be broken (Tyrian, Blake Stone, Keen all shipped fixes),
# so cap at a day and let revalidation pick up a repaired zip.
/apps/*.zip
  Cache-Control: public, max-age=86400
  Content-Type: application/zip

# Recently-played helper: same short TTL as the other first-party scripts so a
# fix reaches users quickly.
/recent.js
  Cache-Control: public, max-age=60, must-revalidate

# Save bridge injected into the Emscripten ports' own pages. Short TTL for the
# same reason, and deliberately not covered by any /apps/* immutable rule.
/apps/_shared/*
  Cache-Control: public, max-age=60, must-revalidate

# Catch-all: baseline security headers only (no cross-origin isolation — see
# the COOP/COEP note at the top of this file).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The 64-bit runtime is a pthreads build: it genuinely needs SharedArrayBuffer,
# so its pages keep full cross-origin isolation. No ads are served under /64/.
/64/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Open Cadet WASM bundle — always revalidate so updates show immediately.
# NOTE: COOP is relaxed to unsafe-none for the game via Pages Functions
# (functions/apps/space-cadet/_middleware.js and
# functions/run/space-cadet-open/_middleware.js), NOT here — _headers only
# MERGES headers (can't remove the catch-all's COOP: same-origin), which left a
# conflicting double header. Functions REPLACE the header authoritatively.
/apps/space-cadet/*
  Cache-Control: no-cache, must-revalidate
