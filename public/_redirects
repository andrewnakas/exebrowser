/index.html / 301

# Games that were staged then withdrawn before launch. Cloudflare Pages keeps
# files from previous deploys, so these URLs would otherwise linger as orphans
# serving stale "boot test pending" pages. Point them at the hub instead.
# epic-pinball / jazz-jackrabbit: never booted (no frame ever delivered);
# major-stryker: its own startup screen says it is not redistributable.
/run/epic-pinball/* /run/ 301
/run/jazz-jackrabbit/* /run/ 301
/run/major-stryker/* /run/ 301
/apps/epic-pinball/* /run/ 301
/apps/jazz-jackrabbit/* /run/ 301
/apps/major-stryker/* /run/ 301

# freeciv is played through an external iframe; its 24 MB local payload was
# never referenced and has been removed. Pages keeps prior-deploy files, so
# retire the URL explicitly.
/apps/freeciv/* /run/freeciv/ 301

# 2048 withdrawn 2026-08-17 at the owner's request. Pages keeps files from
# prior deploys, so retire both the guide page and the app explicitly.
/run/2048-open/* /run/ 301
/apps/2048-open/* /run/ 301

# An EXE the visitor uploaded is saved under "byo-<hash>" and has no page.
# Until 2026-10-01 the Resume link for those saves pointed at /run/byo-…/,
# which was ~100% of the site's 404s. recent.js now sends them to the loader;
# this catches the old links still sitting in browsers' cached recent.js.
/run/byo-* /load-exe/ 302
/run/home/ /load-exe/ 302
